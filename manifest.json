{
    "name": "AdBlock",
    "version": "1.0",
    "description": "A simple ad blocker extension",
    "manifest_version": 3,
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "storage",
        "tabs",
        "cookies",
        "activeTab"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["blocking/ad-constants.js","blocking/ad-heuristics.js","blocking/cosmetic-engine.js","blocking/study-blocker.js","blocking/study-ui.js","blocking/element-picker.js","blocking/dom-observer.js","blocking/fullpage-capture.js", "content.js"],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],

    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules/rule.json"
            }
        ]
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "AdBlock Extension"
    },
    "web_accessible_resources": [
    {
      "resources": ["phishing-alert.html"],
      "matches": ["<all_urls>"]
    }
  ]
}